{
  "expo": {
    "name": "House Keeper",
    "slug": "house-keeper",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "housekeeper",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.khoinguyen.housekeeper",
      "buildNumber": "3",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "House Keeper dùng camera để quét giấy tờ, hóa đơn và thông tin bảo hành.",
        "NSPhotoLibraryUsageDescription": "House Keeper cần truy cập ảnh bạn chọn để trích xuất thông tin."
      }
    },
    "android": {
      "package": "com.khoinguyen.housekeeper",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép House Keeper đọc ảnh bạn chọn để quét tài liệu.",
          "cameraPermission": "Cho phép House Keeper dùng camera để quét tài liệu."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0058BE"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
